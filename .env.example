# Configuración para desarrollo local con Servidor Central Gemma 4
# Si el servidor corre en tu misma máquina:
# AI_SERVER_URL=http://localhost:11434/v1

# Si el servidor corre en la máquina de tu compañero (vía Cloudflare Tunnel):
AI_SERVER_URL=https://tu-subdominio.trycloudflare.com/v1
AI_MODEL_NAME=gemma4:e4b
AI_FALLBACK_MODEL=gemma4:e2b
AI_API_KEY=ollama

# Opcional: Plan B en la nube (Google AI Studio)
# AI_SERVER_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_API_KEY=AIzaSy...
# AI_MODEL_NAME=gemini-2.5-flash
